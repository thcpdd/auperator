# Auperator 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# =============================================
# API 配置
# =============================================

# API 服务监听地址（127.0.0.1 表示所有网络接口）
API_HOST=127.0.0.1

# API 服务端口
API_PORT=7000

# 开发模式自动重载（生产环境建议设为 false）
API_RELOAD=false

# Worker 进程数（生产环境建议设为 CPU 核心数）
API_WORKERS=1

# =============================================
# OpenAI 配置
# =============================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=your_api_base
OPENAI_MODEL=glm-4.7

# =============================================
# Redis 配置
# =============================================

# Redis 主机地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码（可选，如无密码可留空）
REDIS_PASSWORD=

# Redis 数据库编号（可选，默认 0）
REDIS_DB=0

# Redis 键前缀（用于避免 key 冲突）
REDIS_KEY_PREFIX=auperator:

# Redis List 名称（Vector 写入，Auperator 消费）
REDIS_LIST_NAME=logs:main

# =============================================
# 消费者配置
# =============================================

# 批处理大小 (每次读取的消息数)
CONSUMER_BATCH_SIZE=1

# 阻塞超时（秒）
CONSUMER_BLOCK_TIMEOUT=5

# =============================================
# 通用配置
# =============================================

# 默认日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# 环境标识 (production/staging/development)
ENVIRONMENT=development

# =============================================
# LangFuse配置
# =============================================
LANGFUSE_PUBLIC_KEY=your_public_key
LANGFUSE_SECRET_KEY=your_secret_key
LANGFUSE_HOST=https://langfuse.com

# =============================================
# Daytona 配置
# =============================================

# Daytona API Key
DAYTONA_API_KEY=

# Daytona API URL
DAYTONA_API_URL=https://app.daytona.io/api

# Daytona 沙箱存活时间（秒）
DAYTONA_SANDBOX_TIMEOUT=3600

# =============================================
# Repository Remote 配置
# =============================================
# 远程仓库 URL
REMOTE_REPO_URL=https://github.com/your-username/your-repo.git

# =============================================
# Pull Request 配置
# =============================================

# GitHub Personal Access Token
# 用于创建和管理 Pull Requests
# 需要 repo 权限（私有仓库）或 public_repo 权限（仅公开仓库）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# Drain3 配置
# =============================================

# Drain3 状态持久化文件路径
# 用于保存学习的日志模板，服务重启后可以恢复
DRAIN3_STATE_FILE=drain3.json

# Drain3 树深度（最小值为3，值越大模板越精细）
DRAIN3_DEPTH=4

# Drain3 最大集群数（控制内存使用）
DRAIN3_MAX_CLUSTERS=1000

# Drain3 每个节点的最大子节点数
DRAIN3_MAX_CHILDREN=100

# Drain3 相似度阈值（0-1之间，值越高越严格）
DRAIN3_SIM_TH=0.4
